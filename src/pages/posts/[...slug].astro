---
import path from "node:path";
import License from "@components/misc/License.astro";
import SeriesNav from "@components/SeriesNav.astro";
import Giscus from "@components/Giscus.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { giscusConfig, licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import KnowledgeGraph from "../../components/graph/KnowledgeGraph.svelte";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getGraphData, getLocalGraphData } from "../../utils/graph-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();

const fullGraph = await getGraphData();
const localGraphData = getLocalGraphData(entry.slug, fullGraph);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" data-reading-minutes={remarkPluginFrontmatter.minutes || 1} class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full min-w-0 max-w-full",
            {}
        ]}>
            <!-- VCR Terminal Playback Monitor Header HUD -->
            <div class="vcr-playback-hud onload-animation flex items-center justify-between mb-5 px-3.5 py-2 rounded-xl bg-black/5 dark:bg-white/[0.04] border border-black/10 dark:border-white/10 font-mono text-[11px] select-none">
                <div class="flex items-center gap-2">
                    <span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] animate-pulse shadow-[0_0_8px_var(--primary)]"></span>
                    <span class="font-bold text-[var(--primary)] tracking-wider">● PLAYING [VCR-DECK]</span>
                    <span class="text-black/40 dark:text-white/40 hidden sm:inline">// Hi-Fi 48kHz STEREO</span>
                </div>
                <div class="flex items-center gap-2 font-mono">
                    <span class="text-black/40 dark:text-white/40 hidden md:inline">CODEC: VHS-HQ</span>
                    <span class="px-2 py-0.5 rounded-md bg-[var(--primary)]/15 border border-[var(--primary)]/30 text-[var(--primary)] font-bold text-[10px] tracking-wider">
                        TAPE LOADED
                    </span>
                </div>
            </div>

            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <SeriesNav name={entry.data.series} slug={entry.slug} />
            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {localGraphData.nodes.length > 1 && (
                <div class="mb-6 rounded-2xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] p-4 onload-animation">
                    <div class="flex items-center justify-between mb-3 px-1">
                        <div class="flex items-center gap-2">
                            <span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] shadow-[0_0_8px_var(--primary)] animate-pulse"></span>
                            <span class="font-mono text-xs font-bold text-black/80 dark:text-white/80">
                                本文关联知识星网 // LOCAL GRAPH ({localGraphData.nodes.length - 1} 个关联维度)
                            </span>
                        </div>
                        <a href="/graph/" class="text-xs font-mono text-[var(--primary)] hover:underline flex items-center gap-1">
                            <span>探索全域星系 ↗</span>
                        </a>
                    </div>
                    <KnowledgeGraph graphData={localGraphData} isLocal={true} activeSlug={entry.slug} client:only="svelte" />
                </div>
            )}

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    {giscusConfig.enable && entry.data.comments && !entry.data.draft && (
        <Giscus slug={entry.slug} discussion={entry.data.discussion} commentTerm={entry.data.commentTerm} />
    )}
</MainGridLayout>
