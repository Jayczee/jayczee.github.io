---
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import GithubCalendar from "../components/widget/GithubCalendar.svelte";
import { profileConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// 个人展示主页 (Showcase & Profile)
// 你可以在这里直接增加、修改或重新排列板块，展示你真正想展示的内容。

// 精选项目列表（以后增加项目直接在这里追加即可）
const projects = [
	{
		title: "个人博客与数字空间",
		category: "Web / Open Source",
		url: "https://github.com/Jayczee/jayczee.github.io",
		tech: ["Astro", "Tailwind CSS", "Svelte", "TypeScript"],
		description:
			"基于 Astro 深度定制的个人技术博客与展示主页。具备全站搜索、暗色模式、精选文章分类与高度个性化的组件化设计，追求极速加载与清爽的阅读体验。",
	},
	{
		title: "AI 工具协议重写代理 (Rewrite Proxy)",
		category: "AI / Middleware",
		url: "/posts/opencode-go-deepseek-flash-newapi-chatgpt-desktop-tool-call/",
		tech: ["Python", "Nginx", "DeepSeek", "new-api"],
		description:
			"用于解决桌面端 Codex Agent 与国产大模型之间的协议方言差异。支持流式 DSML 裸标签拦截还原、custom 自由文本工具参数解包封包，以及中断造成的悬挂调用自动修复。",
	},
	{
		title: "HomeLab 与自建服务生态",
		category: "DevOps / Self-hosted",
		tech: ["Docker", "Linux", "Nginx", "NAS"],
		description:
			"基于 Linux 与 Docker 打造的家庭私有云与开发测试基底。包含反向代理、内网穿透、私有化知识库与容器自动化部署，享受数据掌握在自己手中的自由。",
	},
];

// 技术栈与工具箱
const techStacks = [
	{
		category: "核心语言",
		items: ["Java", "TypeScript", "JavaScript", "Python", "SQL", "Bash"],
	},
	{
		category: "前端与全栈",
		items: ["Vue", "React", "Astro", "Tailwind CSS", "Svelte", "HTML/CSS"],
	},
	{
		category: "后端与基础设施",
		items: ["Spring Boot", "Node.js", "Docker", "Nginx", "Redis", "MySQL", "Linux"],
	},
	{
		category: "常用利器与环境",
		items: ["VS Code", "Git", "Cursor", "NAS", "Postman", "Docker Desktop"],
	},
];

// 当前关注的探索方向
const focusAreas = [
	{
		title: "AI Agent 与工作流自动化",
		desc: "探索大模型工具调用、智能体工作流在真实编码与日常任务中的实践落地。",
		icon: "material-symbols:smart-toy-outline-rounded",
	},
	{
		title: "现代全栈开发实践",
		desc: "关注现代前后端技术演进，追求高质感的交互体验与简洁的架构设计。",
		icon: "material-symbols:code-rounded",
	},
	{
		title: "自建服务与软硬件折腾",
		desc: "持续折腾 NAS、家庭网络与自动化工具，把踩坑排错的过程整理成实用文章。",
		icon: "fa6-solid:server",
	},
];
---

<MainGridLayout title="About" description="Jayczee - Profile & Showcase">
    <div class="flex flex-col gap-4">
        <section class="card-base px-6 md:px-9 py-6 md:py-8 flex flex-col md:flex-row gap-6 items-center md:items-start onload-animation">
            {profileConfig.avatar && (
                <div class="relative shrink-0 w-24 h-24 md:w-28 md:h-28 rounded-2xl overflow-hidden ring-2 ring-[var(--line-divider)] shadow-md">
                    <ImageWrapper src={profileConfig.avatar} alt="Avatar" class="w-full h-full object-cover"></ImageWrapper>
                </div>
            )}
            <div class="flex-1 text-center md:text-left">
                <div class="flex flex-col md:flex-row md:items-center gap-2 mb-2">
                    <h1 class="text-3xl font-extrabold text-90 tracking-tight">Jayczee</h1>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[var(--btn-regular-bg)] text-[var(--primary)] self-center md:self-auto border border-[var(--line-divider)]">
                        <span class="w-2 h-2 rounded-full bg-[var(--primary)] animate-pulse"></span>
                        Fullstack Develop · 折腾 & 创造
                    </span>
                </div>
                
                <p class="text-75 text-sm md:text-base leading-relaxed mb-4 max-w-2xl">
                    热衷于探索现代Coding技术、自建服务与 AI 相关。展示真实的作品、技术探索与踩坑记录。
                </p>

                <div class="flex flex-wrap gap-2.5 justify-center md:justify-start">
                    <a href="https://github.com/Jayczee" target="_blank" aria-label="GitHub"
                       class="btn-regular rounded-xl h-9 px-3.5 gap-2 text-sm font-medium hover:text-[var(--primary)] transition active:scale-95">
                        <Icon name="fa6-brands:github" class="text-base"></Icon>GitHub
                    </a>
                    <a href="mailto:jayczee2716@gmail.com" aria-label="Email"
                       class="btn-regular rounded-xl h-9 px-3.5 gap-2 text-sm font-medium hover:text-[var(--primary)] transition active:scale-95">
                        <Icon name="fa6-solid:envelope" class="text-base"></Icon>Email
                    </a>
                    <a href="/blog/" aria-label="Blog"
                       class="btn-regular rounded-xl h-9 px-3.5 gap-2 text-sm font-medium hover:text-[var(--primary)] transition active:scale-95">
                        <Icon name="material-symbols:article-outline-rounded" class="text-base"></Icon>博客文章
                    </a>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 onload-animation">
            {focusAreas.map((item) => (
                <div class="card-base p-5 flex flex-col gap-2 transition hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-center gap-2 text-[var(--primary)] font-bold text-base">
                        <Icon name={item.icon} class="text-xl"></Icon>
                        <span>{item.title}</span>
                    </div>
                    <p class="text-75 text-sm leading-relaxed">{item.desc}</p>
                </div>
            ))}
        </section>

        <!-- GitHub 提交活跃度热力图 -->
        <GithubCalendar client:load username="Jayczee" />

        <section class="card-base px-6 md:px-9 py-6 onload-animation">
            <div class="flex items-center justify-between mb-4">
                <h2 class="showcase-heading text-90">精选项目与折腾</h2>
                <span class="text-50 text-xs">Projects & Works</span>
            </div>

            <div class="grid grid-cols-1 gap-4">
                {projects.map((p) => (
                    <div class="rounded-xl p-5 bg-[var(--btn-regular-bg)] border border-[var(--line-divider)] hover:border-[var(--primary)] transition-all duration-300">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="text-90 font-bold text-base md:text-lg">{p.title}</span>
                                {p.category && (
                                    <span class="text-[0.7rem] px-2 py-0.5 rounded-full bg-[var(--card-bg)] text-50 font-medium border border-[var(--line-divider)]">
                                        {p.category}
                                    </span>
                                )}
                            </div>
                            {p.url && (
                                <a href={p.url} target={p.url.startsWith("http") ? "_blank" : undefined}
                                   aria-label={`${p.title} 链接`}
                                   class="inline-flex items-center gap-1 text-xs text-50 hover:text-[var(--primary)] transition self-start sm:self-auto">
                                    <span>查看详情</span>
                                    <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs"></Icon>
                                </a>
                            )}
                        </div>
                        <p class="text-75 text-sm leading-relaxed mb-3">{p.description}</p>
                        <div class="flex flex-wrap gap-1.5">
                            {p.tech.map((t) => (
                                <span class="text-xs px-2.5 py-0.5 rounded-md bg-[var(--card-bg)] text-[var(--primary)] font-medium">
                                    {t}
                                </span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section class="card-base px-6 md:px-9 py-6 onload-animation">
            <div class="flex items-center justify-between mb-4">
                <h2 class="showcase-heading text-90">技术栈与工具箱</h2>
                <span class="text-50 text-xs">Tech Stack & Tools</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {techStacks.map((group) => (
                    <div class="rounded-xl p-4 bg-[var(--btn-regular-bg)] border border-[var(--line-divider)] flex flex-col gap-2.5">
                        <div class="text-sm font-bold text-75 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)]"></span>
                            {group.category}
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            {group.items.map((tech) => (
                                <span class="text-xs px-2.5 py-1 rounded-lg bg-[var(--card-bg)] text-75 font-medium border border-[var(--line-divider)] transition hover:text-[var(--primary)] hover:border-[var(--primary)]">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section class="card-base px-6 md:px-9 py-6 onload-animation">
            <h2 class="showcase-heading text-90">关于这里</h2>
            <div class="text-75 text-sm leading-relaxed space-y-3">
                <p>
                    这里是我的个人技术空间、一份持续生长的数字展板。
                </p>
                <p>
                    后续如果有了新的开源项目、折腾日志或好玩的技术尝试，我都会直接同步更新在这个页面。如果你对我的项目或博客内容感兴趣，欢迎通过邮件或 GitHub 交流探讨。
                </p>
            </div>
        </section>
    </div>
</MainGridLayout>

<style>
    .showcase-heading {
        @apply relative text-lg md:text-xl font-bold pl-3.5;
    }
    .showcase-heading::before {
        content: "";
        @apply absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-4 md:h-5 rounded-full bg-[var(--primary)];
    }
</style>
