---
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { profileConfig, siteConfig } from "../config";
import Layout from "../layouts/Layout.astro";
import { url } from "../utils/url-utils";

// Landing page of the site: a full-screen hero with entries to the blog and the resume.
// It intentionally doesn't use MainGridLayout (no navbar / sidebar / banner),
// so links here use `data-no-swup` to do a full page load (see the swup `ignore` option in astro.config.mjs).

const entries = [
	{
		label: "博文",
		desc: "Blog",
		href: url("/blog/"),
		icon: "material-symbols:article-outline-rounded",
		primary: true,
	},
	{
		label: "About me",
		desc: "Profile",
		href: url("/resume/"),
		icon: "material-symbols:person-outline-rounded",
		primary: false,
	},
];
---

<Layout description={siteConfig.subtitle}>
    <div id="landing" class="relative min-h-screen w-full overflow-hidden flex items-center justify-center px-6">
        <!-- SVG Filters for authentic ZZZ street-chalk / dry-brush texture -->
        <svg class="sr-only" aria-hidden="true">
            <defs>
                <filter id="zzz-chalk" x="-10%" y="-10%" width="120%" height="120%">
                    <feTurbulence type="fractalNoise" baseFrequency="0.045 0.14" numOctaves="3" seed="7" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
                </filter>
                <filter id="zzz-sky-marker" x="-10%" y="-10%" width="120%" height="120%">
                    <feTurbulence type="fractalNoise" baseFrequency="0.06 0.09" numOctaves="2" seed="3" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.8" xChannelSelector="R" yChannelSelector="G" />
                </filter>
            </defs>
        </svg>

        <!-- Mobile / Tablet Background (< lg): reuse the blurred banner image -->
        {siteConfig.banner.enable && (
            <div class="absolute inset-0 lg:hidden">
                <ImageWrapper id="landing-bg" alt="Background image" src={siteConfig.banner.src} position={siteConfig.banner.position}
                              class="w-full h-full scale-105 blur-[2px]"
                ></ImageWrapper>
            </div>
        )}
        <div class="absolute inset-0 lg:hidden bg-gradient-to-b from-black/40 via-black/30 to-black/60 dark:from-black/60 dark:via-black/50 dark:to-black/80"></div>

        <!-- Widescreen Background (lg+): full-screen animated video -->
        <div class="hidden lg:block absolute inset-0 bg-[#0d1726]">
            <link rel="preload" as="image" href={url("/videos/landing-poster.webp")} media="(min-width: 1024px)" />
            <link rel="preload" as="video" href={url("/videos/landing-bg.mp4")} type="video/mp4" media="(min-width: 1024px)" />
            <link rel="preload" as="font" type="font/woff2" href={url("/fonts/kaushan-script.woff2")} crossorigin media="(min-width: 1024px)" />
            <link rel="preload" as="font" type="font/woff2" href={url("/fonts/caveat-brush.woff2")} crossorigin media="(min-width: 1024px)" />
            <video
                id="landing-video"
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                poster={url("/videos/landing-poster.webp")}
                class="w-full h-full object-cover object-[50%_25%] select-none pointer-events-none"
            >
                <source src={url("/videos/landing-bg.mp4")} type="video/mp4" media="(min-width: 1024px)" />
            </video>
            <!-- Subtle edge vignette to enhance wall & sky typography contrast without dimming Belle -->
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_52%_50%,transparent_55%,rgba(0,0,0,0.28)_100%)]"></div>
        </div>

        <!-- ================================================================= -->
        <!-- WIDESCREEN SCENE OVERLAY (lg+): Wall Graffiti & Sky Signage       -->
        <!-- ================================================================= -->
        <div class="hidden lg:block absolute inset-0 z-10 pointer-events-none">
            <!-- Upper-Left Building Wall: Crown + Jayczee + Exploring the world -->
            <div
                class="absolute top-[14.5%] left-[6.8%] xl:left-[7.4%] select-none pointer-events-auto"
            >
                <div class="zzz-wall-group">
                    <!-- Hand-drawn 3-point graffiti crown matching original Belle artwork -->
                    <svg
                        viewBox="0 0 120 82"
                        class="w-[4.6rem] xl:w-[5.4rem] h-auto ml-[6.8rem] xl:ml-[8.4rem] -mb-3 xl:-mb-4 opacity-95 zzz-chalk-el"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path
                            class="crown-path-1"
                            pathLength="1000"
                            d="M18 60 L12 22 L40 43 L60 12 L80 43 L108 20 L98 60 Z"
                            stroke="rgba(232, 241, 249, 0.94)"
                            stroke-width="6.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <path
                            class="crown-path-2"
                            pathLength="100"
                            d="M16 71 C42 68, 76 67, 101 70"
                            stroke="rgba(232, 241, 249, 0.9)"
                            stroke-width="5.5"
                            stroke-linecap="round"
                        />
                    </svg>

                    <!-- Main Wall Graffiti Title: Jayczee (Handwritten Stroke Flow) -->
                    <div class="relative inline-block">
                        <span class="sr-only">{profileConfig.name}</span>
                        <svg
                            viewBox="0 0 310 145"
                            class="zzz-wall-title-svg zzz-chalk-el block w-[23.5rem] xl:w-[28.5rem] max-w-full h-auto overflow-visible select-none"
                            aria-hidden="true"
                        >
                            <defs>
                                <mask id="jayczee-write-mask" maskUnits="userSpaceOnUse" x="-30" y="-30" width="370" height="200">
                                    <rect x="-30" y="-30" width="370" height="200" fill="black" />
                                    <path
                                        class="jayczee-pen-path"
                                        pathLength="1000"
                                        d="M 25.9 43.2 C 37.8 34.8, 46.3 33.1, 42.9 50.1 C 37.8 73.0, 32.7 92.5, 19.1 111.2 C 12.3 119.8, 24.2 126.5, 36.1 118.0 C 48.0 107.8, 49.7 90.0, 58.2 77.2 C 66.7 64.5, 77.8 63.7, 70.1 79.0 C 63.3 90.8, 73.5 94.2, 85.4 84.0 C 93.9 70.5, 104.1 67.0, 107.5 81.5 C 110.9 94.2, 121.1 70.5, 126.2 84.0 C 129.6 102.8, 127.9 126.5, 117.7 132.5 C 109.2 136.8, 114.3 115.5, 129.6 87.5 C 138.1 70.5, 154.2 67.0, 146.6 84.0 C 141.5 94.2, 156.8 94.2, 167.0 81.5 C 172.1 70.5, 188.2 67.0, 178.9 81.5 C 171.2 90.0, 170.4 115.5, 179.8 124.8 C 190.8 129.9, 196.8 107.0, 205.2 84.0 C 212.9 68.8, 226.5 65.3, 219.7 84.0 C 214.6 94.2, 233.3 90.8, 239.2 81.5 C 246.9 68.8, 260.5 65.3, 253.7 84.0 C 248.6 94.2, 273.2 87.5, 290.2 79.0"
                                        stroke="white"
                                        stroke-width="52"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        fill="none"
                                    />
                                </mask>
                                <linearGradient id="jayczee-text-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="rgba(241, 247, 253, 0.96)" />
                                    <stop offset="62%" stop-color="rgba(203, 218, 232, 0.88)" />
                                    <stop offset="100%" stop-color="rgba(170, 190, 209, 0.8)" />
                                </linearGradient>
                            </defs>
                            <text
                                x="14"
                                y="92"
                                class="zzz-wall-title-text"
                                fill="url(#jayczee-text-grad)"
                                mask="url(#jayczee-write-mask)"
                            >
                                {profileConfig.name}
                            </text>
                        </svg>
                        <!-- Expressive dry-brush underline slash -->
                        <svg
                            viewBox="0 0 360 28"
                            class="w-[74%] h-auto -mt-2 xl:-mt-3 ml-2 opacity-90 zzz-chalk-el"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                class="underline-path-1"
                                pathLength="1000"
                                d="M6 18 C95 8, 220 6, 352 13"
                                stroke="rgba(230, 239, 248, 0.88)"
                                stroke-width="5.2"
                                stroke-linecap="round"
                            />
                            <path
                                class="underline-path-2"
                                pathLength="1000"
                                d="M28 24 C110 17, 200 16, 290 20"
                                stroke="rgba(230, 239, 248, 0.58)"
                                stroke-width="2.5"
                                stroke-linecap="round"
                            />
                        </svg>
                    </div>

                    <!-- Wall Subtitle: Exploring the world -->
                    {profileConfig.bio && (
                        <p class="zzz-wall-sub zzz-chalk-el mt-1 ml-[4.6rem] xl:ml-[5.8rem]">
                            {profileConfig.bio}
                        </p>
                    )}
                </div>
            </div>

            <!-- Upper-Right Sky Area: Staggered Street-Art Navigation Buttons -->
            <nav
                aria-label="Primary Navigation"
                class="zzz-sky-nav absolute top-[11.5%] right-[4.8%] xl:right-[5.6%] pointer-events-auto select-none"
            >
                <div class="zzz-sky-group flex flex-col items-start gap-2 xl:gap-2.5">
                    {entries.map((e, idx) => (
                        <a
                            href={e.href}
                            data-no-swup
                            class:list={[
                                "zzz-sky-link group relative inline-flex items-center gap-2.5 px-1 py-0.5",
                                idx === 0 ? "zzz-sky-link-1" : "zzz-sky-link-2 ml-8 xl:ml-10",
                            ]}
                        >
                            {idx === 0 && (
                                <span class="zzz-sky-dash mr-0.5" aria-hidden="true">
                                    <span class="block w-8 xl:w-10 h-[3.5px] bg-white rounded-full"></span>
                                    <span class="block w-5 xl:w-6 h-[2.2px] bg-white/85 rounded-full mt-1 ml-2"></span>
                                </span>
                            )}
                            <span class="zzz-sky-text">
                                {e.label}
                            </span>
                            <span
                                class="zzz-sky-arrow inline-flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1.5 group-hover:-translate-y-0.5"
                                aria-hidden="true"
                            >
                                !
                            </span>
                            <!-- Brush stroke hover underline -->
                            <svg
                                viewBox="0 0 200 14"
                                class="pointer-events-none absolute -bottom-1 left-0 w-full h-3 opacity-85 group-hover:opacity-100 transition-opacity duration-300"
                                fill="none"
                                aria-hidden="true"
                            >
                                <path
                                    d="M6 10 C64 4, 138 3, 194 8"
                                    class="stroke-white/85 group-hover:stroke-[#ff6b00] transition-colors duration-300"
                                    stroke-width="3.8"
                                    stroke-linecap="round"
                                />
                            </svg>
                        </a>
                    ))}
                </div>
            </nav>

            <!-- Bottom-Right Subtle Social Icons on Widescreen -->
            {profileConfig.links.length > 0 && (
                <div
                    class="zzz-social-widescreen absolute bottom-5 right-6 flex items-center gap-2.5 pointer-events-auto"
                >
                    {profileConfig.links.map((item) => (
                        <a
                            rel="me"
                            aria-label={item.name}
                            href={item.url}
                            target="_blank"
                            class="flex items-center justify-center w-9 h-9 rounded-xl bg-black/25 backdrop-blur-sm ring-1 ring-white/20 text-white/80 hover:text-white hover:bg-black/45 transition active:scale-90"
                        >
                            <Icon name={item.icon} class="text-[1.2rem]"></Icon>
                        </a>
                    ))}
                </div>
            )}
        </div>

        <!-- ================================================================= -->
        <!-- MOBILE / TABLET HERO (< lg): Centered Avatar + Particle Title     -->
        <!-- ================================================================= -->
        <main class="relative z-10 flex lg:hidden flex-col items-center text-center max-w-xl">
            {profileConfig.avatar && (
                <div class="landing-item w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden ring-4 ring-white/30 shadow-2xl mb-6 transition-transform duration-500 hover:scale-[1.03]" style="animation-delay: 0ms">
                    <ImageWrapper src={profileConfig.avatar} alt="Avatar" class="w-full h-full"></ImageWrapper>
                </div>
            )}

            <h1 class="landing-item relative flex items-center justify-center mb-2" style="animation-delay: 100ms">
                <span class="sr-only">{profileConfig.name}</span>
                <canvas
                    id="particle-title"
                    data-name={profileConfig.name}
                    aria-hidden="true"
                    class="block w-[19rem] h-[4.25rem] md:w-[23rem] md:h-[5.25rem] select-none"
                ></canvas>
            </h1>
            <div class="landing-item h-1 w-8 rounded-full bg-[var(--primary)] mb-4" style="animation-delay: 150ms"></div>
            {profileConfig.bio && (
                <p class="landing-item text-white/75 text-base md:text-lg mb-10" style="animation-delay: 200ms">{profileConfig.bio}</p>
            )}

            <!-- Entry buttons -->
            <div class="landing-item flex flex-col sm:flex-row gap-4 w-full sm:w-auto" style="animation-delay: 300ms">
                {entries.map((e) => (
                    <a href={e.href} data-no-swup
                       class:list={[
                           "landing-btn group flex items-center whitespace-nowrap justify-center gap-3 h-14 px-8 rounded-2xl font-bold text-lg",
                           "transition duration-300 hover:-translate-y-0.5 active:scale-95 backdrop-blur-md",
                           e.primary
                               ? "bg-[var(--primary)] text-white shadow-lg shadow-black/20 hover:brightness-110"
                               : "bg-white/15 text-white ring-1 ring-white/40 hover:bg-white/25",
                       ]}
                    >
                        <Icon name={e.icon} class="text-[1.5rem]"></Icon>
                        <span>{e.label}</span>
                        <Icon name="material-symbols:arrow-forward-rounded" class="text-[1.25rem] -ml-1 opacity-70 transition group-hover:translate-x-1"></Icon>
                    </a>
                ))}
            </div>

            <!-- Social links -->
            {profileConfig.links.length > 0 && (
                <div class="landing-item flex gap-3 mt-10" style="animation-delay: 400ms">
                    {profileConfig.links.map((item) => (
                        <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                           class="flex items-center justify-center w-10 h-10 rounded-xl text-white/70 hover:text-white hover:bg-white/15 transition active:scale-90"
                        >
                            <Icon name={item.icon} class="text-[1.375rem]"></Icon>
                        </a>
                    ))}
                </div>
            )}
        </main>

        <footer class="absolute bottom-4 left-0 right-0 text-center text-xs text-white/50 z-10 pointer-events-none">
            © {new Date().getFullYear()} {profileConfig.name}
        </footer>
    </div>
</Layout>

<style>
    @font-face {
        font-family: "Kaushan Script";
        src: url("/fonts/kaushan-script.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    @font-face {
        font-family: "Caveat Brush";
        src: url("/fonts/caveat-brush.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    @font-face {
        font-family: "Ma Shan Zheng";
        src: url("/fonts/ma-shan-zheng-bowen.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    @keyframes landing-fade-in-up {
        from {
            opacity: 0;
            transform: translateY(1.5rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .landing-item {
        opacity: 0;
        animation: landing-fade-in-up 600ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* Upper-Left Building Wall Graffiti */
    .zzz-wall-group {
        transform: rotate(-16deg) skewX(-6deg);
        transform-origin: left center;
    }

    .zzz-chalk-el {
        filter: url(#zzz-chalk) drop-shadow(3px 6px 9px rgba(6, 12, 24, 0.55));
    }

    /* 1. Crown stroke drawing */
    .crown-path-1 {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: draw-crown 440ms cubic-bezier(0.3, 0, 0.2, 1) 80ms forwards;
    }
    .crown-path-2 {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
        animation: draw-crown-base 220ms cubic-bezier(0.3, 0, 0.2, 1) 440ms forwards;
    }
    @keyframes draw-crown {
        0% { stroke-dashoffset: 1000; }
        100% { stroke-dashoffset: 0; }
    }
    @keyframes draw-crown-base {
        0% { stroke-dashoffset: 100; }
        100% { stroke-dashoffset: 0; }
    }

    /* 2. Main Wall Graffiti Title: Jayczee (Handwritten Stroke Mask) */
    .zzz-wall-title-text {
        font-family: "Kaushan Script", "SignPainter-HouseScript", "Brush Script MT", cursive;
        font-size: 82px;
        font-weight: 400;
        letter-spacing: 0.01em;
    }

    .jayczee-pen-path {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: draw-jayczee 1250ms cubic-bezier(0.42, 0, 0.58, 1) 450ms forwards;
    }
    @keyframes draw-jayczee {
        0% { stroke-dashoffset: 1000; }
        100% { stroke-dashoffset: 0; }
    }

    /* 3. Underline slash dynamic streaks */
    .underline-path-1 {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: draw-underline 420ms cubic-bezier(0.25, 1, 0.5, 1) 1600ms forwards;
    }
    .underline-path-2 {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: draw-underline 380ms cubic-bezier(0.25, 1, 0.5, 1) 1720ms forwards;
    }
    @keyframes draw-underline {
        0% { stroke-dashoffset: 1000; }
        100% { stroke-dashoffset: 0; }
    }

    /* 4. Subtitle Exploring the world chalk reveal */
    .zzz-wall-sub {
        font-family: "Caveat Brush", "Kaushan Script", "Chalkboard SE", cursive;
        font-size: clamp(1.5rem, 2.3vw, 2.35rem);
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: rgba(218, 231, 243, 0.9);
        clip-path: inset(-15% 100% -15% -5%);
        animation: draw-subtitle 680ms cubic-bezier(0.25, 1, 0.5, 1) 1950ms forwards;
    }
    @keyframes draw-subtitle {
        0% {
            clip-path: inset(-15% 100% -15% -5%);
            opacity: 0.3;
        }
        100% {
            clip-path: inset(-15% -5% -15% -5%);
            opacity: 1;
        }
    }

    /* 5. Upper-Right Sky Handwritten Signage Pop-in */
    .zzz-sky-group {
        transform: rotate(-13.5deg) skewX(-6deg);
        transform-origin: right top;
    }

    .zzz-sky-nav {
        opacity: 0;
        animation: sky-nav-enter 650ms cubic-bezier(0.22, 1.2, 0.36, 1) 2450ms forwards;
    }
    @keyframes sky-nav-enter {
        0% {
            opacity: 0;
            transform: translateY(1.2rem) scale(0.92);
        }
        60% {
            opacity: 1;
            transform: translateY(-0.1rem) scale(1.03);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .zzz-sky-link {
        filter: drop-shadow(0 3px 10px rgba(10, 42, 88, 0.62));
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), filter 260ms ease;
    }

    .zzz-sky-link:hover {
        transform: translate(5px, -2px) scale(1.05);
        filter: drop-shadow(0 5px 16px rgba(10, 42, 88, 0.82));
    }

    .zzz-sky-link-1 {
        animation: sky-btn-bounce 450ms cubic-bezier(0.34, 1.56, 0.64, 1) 2500ms both;
    }
    .zzz-sky-link-2 {
        animation: sky-btn-bounce 450ms cubic-bezier(0.34, 1.56, 0.64, 1) 2650ms both;
    }
    @keyframes sky-btn-bounce {
        0% {
            opacity: 0;
            transform: translateX(1.2rem);
        }
        100% {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .zzz-sky-text {
        font-family: "Caveat Brush", "Kaushan Script", "Ma Shan Zheng", cursive;
        font-size: clamp(1.95rem, 2.65vw, 2.75rem);
        line-height: 1.1;
        letter-spacing: 0.04em;
        color: #ffffff;
        text-shadow: 0 2px 6px rgba(12, 45, 92, 0.45);
        transition: color 250ms ease;
    }

    .zzz-sky-link:hover .zzz-sky-text,
    .zzz-sky-link:hover .zzz-sky-arrow {
        color: #fff3e6;
    }

    .zzz-sky-arrow {
        font-family: "Caveat Brush", "Kaushan Script", cursive;
        font-weight: 800;
        font-size: clamp(1.75rem, 2.35vw, 2.45rem);
        color: #ffffff;
        transition: color 250ms ease, transform 250ms ease;
    }

    /* 6. Bottom-Right Social Icons */
    .zzz-social-widescreen {
        opacity: 0;
        animation: landing-fade-in-up 500ms ease 2850ms forwards;
    }

    @media (prefers-reduced-motion: reduce) {
        .landing-item {
            opacity: 1;
            animation: none;
        }
        .crown-path-1,
        .crown-path-2,
        .jayczee-pen-path,
        .underline-path-1,
        .underline-path-2 {
            stroke-dashoffset: 0 !important;
            animation: none !important;
        }
        .zzz-wall-sub {
            clip-path: none !important;
            animation: none !important;
        }
        .zzz-sky-nav,
        .zzz-sky-link-1,
        .zzz-sky-link-2,
        .zzz-social-widescreen {
            opacity: 1 !important;
            transform: none !important;
            animation: none !important;
        }
    }
</style>

<script>
	interface Particle {
		ox: number;
		oy: number;
		x: number;
		y: number;
		vx: number;
		vy: number;
		nx: number;
		ny: number;
		phase: number;
		size: number;
	}

	function buildColorLUT(): string[] {
		const stops: [number, [number, number, number]][] = [
			[0.0, [255, 255, 255]],
			[0.18, [125, 211, 252]], // #7dd3fc 冰蓝
			[0.32, [186, 230, 253]], // #bae6fd 淡冰蓝
			[0.5, [255, 255, 255]],
			[0.68, [253, 186, 116]], // #fdba74 暖橙
			[0.82, [254, 215, 170]], // #fed7aa 浅暖橙
			[1.0, [255, 255, 255]],
		];
		const lut: string[] = new Array(256);
		for (let i = 0; i < 256; i++) {
			const t = i / 256;
			let s0 = stops[0];
			let s1 = stops[stops.length - 1];
			for (let j = 0; j < stops.length - 1; j++) {
				if (t >= stops[j][0] && t <= stops[j + 1][0]) {
					s0 = stops[j];
					s1 = stops[j + 1];
					break;
				}
			}
			const localT = (t - s0[0]) / (s1[0] - s0[0] || 1);
			const smoothT = localT * localT * (3 - 2 * localT);
			const r = Math.round(s0[1][0] + (s1[1][0] - s0[1][0]) * smoothT);
			const g = Math.round(s0[1][1] + (s1[1][1] - s0[1][1]) * smoothT);
			const b = Math.round(s0[1][2] + (s1[1][2] - s0[1][2]) * smoothT);
			lut[i] = `rgb(${r},${g},${b})`;
		}
		return lut;
	}

	function setupParticleTitle() {
		const canvas = document.getElementById("particle-title") as HTMLCanvasElement | null;
		if (!canvas) return;
		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		const text = canvas.dataset.name || "Jayczee";
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const colorLUT = buildColorLUT();

		let width = 0;
		let height = 0;
		let dpr = 1;
		let particles: Particle[] = [];
		let rafId: number | null = null;
		const pointer = { x: -9999, y: -9999, radius: 46 };

		function sampleText(scatter = false) {
			if (!canvas || !ctx) return;
			const rect = canvas.getBoundingClientRect();
			if (rect.width === 0 || rect.height === 0) {
				if (rafId !== null) {
					cancelAnimationFrame(rafId);
					rafId = null;
				}
				return;
			}
			width = Math.max(Math.round(rect.width), 280);
			height = Math.max(Math.round(rect.height), 64);
			dpr = Math.min(window.devicePixelRatio || 1, 2);

			canvas.width = width * dpr;
			canvas.height = height * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			const offscreen = document.createElement("canvas");
			offscreen.width = width;
			offscreen.height = height;
			const octx = offscreen.getContext("2d");
			if (!octx) return;

			const fontSize = width >= 340 ? 54 : 44;
			octx.font = `800 ${fontSize}px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif`;
			octx.textAlign = "center";
			octx.textBaseline = "middle";
			octx.fillStyle = "#ffffff";
			octx.fillText(text, width / 2, height / 2 + 2);

			const img = octx.getImageData(0, 0, width, height).data;
			particles = [];
			const step = 2;

			for (let y = 0; y < height; y += step) {
				for (let x = 0; x < width; x += step) {
					const alpha = img[(y * width + x) * 4 + 3];
					if (alpha > 120) {
						particles.push({
							ox: x,
							oy: y,
							x: scatter && !reducedMotion ? x + (Math.random() - 0.5) * 20 : x,
							y: scatter && !reducedMotion ? y + (Math.random() - 0.5) * 20 : y,
							vx: 0,
							vy: 0,
							nx: x / width,
							ny: y / height,
							phase: Math.random() * 14,
							size: 1.85,
						});
					}
				}
			}

			drawStaticOrWake();
		}

		function stepFrame(now: number) {
			if (!ctx) return;
			ctx.clearRect(0, 0, width, height);

			const r = pointer.radius;
			const rSq = r * r;
			const waveOffset = now * 0.045;

			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];
				const dx = pointer.x - p.x;
				const dy = pointer.y - p.y;
				const distSq = dx * dx + dy * dy;

				if (distSq < rSq) {
					const dist = Math.sqrt(distSq) || 1;
					const force = (r - dist) / r;
					p.vx -= (dx / dist) * force * 3.4;
					p.vy -= (dy / dist) * force * 3.4;
				}

				const hx = p.ox - p.x;
				const hy = p.oy - p.y;
				p.vx = (p.vx + hx * 0.12) * 0.78;
				p.vy = (p.vy + hy * 0.12) * 0.78;
				p.x += p.vx;
				p.y += p.vy;

				if (
					Math.abs(hx) <= 0.15 &&
					Math.abs(hy) <= 0.15 &&
					Math.abs(p.vx) <= 0.08 &&
					Math.abs(p.vy) <= 0.08
				) {
					p.x = p.ox;
					p.y = p.oy;
				}

				const energyShift = (Math.abs(p.vx) + Math.abs(p.vy)) * 6;
				const lutIdx =
					Math.floor(p.nx * 220 + p.ny * 45 + p.phase - waveOffset + energyShift) & 255;
				ctx.fillStyle = colorLUT[lutIdx];
				ctx.fillRect(p.x, p.y, p.size, p.size);
			}

			if (!document.hidden) {
				rafId = requestAnimationFrame(stepFrame);
			} else {
				rafId = null;
			}
		}

		function wake() {
			if (reducedMotion) return;
			if (rafId === null) {
				rafId = requestAnimationFrame(stepFrame);
			}
		}

		function drawStaticOrWake() {
			if (!ctx) return;
			if (reducedMotion) {
				ctx.clearRect(0, 0, width, height);
				for (const p of particles) {
					const lutIdx = Math.floor(p.nx * 220 + p.ny * 45) & 255;
					ctx.fillStyle = colorLUT[lutIdx];
					ctx.fillRect(p.ox, p.oy, p.size, p.size);
				}
				return;
			}
			wake();
		}

		document.addEventListener("visibilitychange", () => {
			if (!document.hidden) wake();
		});

		canvas.addEventListener("pointermove", (e) => {
			const rect = canvas.getBoundingClientRect();
			pointer.x = e.clientX - rect.left;
			pointer.y = e.clientY - rect.top;
			wake();
		});

		canvas.addEventListener("pointerleave", () => {
			pointer.x = -9999;
			pointer.y = -9999;
			wake();
		});

		canvas.addEventListener("pointerdown", (e) => {
			if (reducedMotion) return;
			const rect = canvas.getBoundingClientRect();
			const cx = e.clientX - rect.left;
			const cy = e.clientY - rect.top;
			for (const p of particles) {
				const dx = p.x - cx;
				const dy = p.y - cy;
				const dist = Math.hypot(dx, dy) || 1;
				if (dist < 90) {
					const impulse = ((90 - dist) / 90) * 8;
					p.vx += (dx / dist) * impulse;
					p.vy += (dy / dist) * impulse;
				}
			}
			wake();
		});

		let resizeTimer: ReturnType<typeof setTimeout>;
		window.addEventListener("resize", () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => sampleText(false), 120);
		});

		sampleText(true);
	}

	setupParticleTitle();
</script>
