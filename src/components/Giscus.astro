---
import { giscusConfig, siteConfig } from "@/config";
import discussions from "@/data/giscus-discussions.json";
import redirects from "@/data/legacy-redirects.json";
import { getCommentMapping } from "@utils/giscus-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	slug: string;
	discussion?: number;
	commentTerm?: string;
}

const { slug, discussion, commentTerm } = Astro.props;
const target = getCommentMapping(slug, redirects, discussions, discussion, commentTerm);
const revision = /^[a-f0-9]{40}$/.test(process.env.GITHUB_SHA ?? "")
	? process.env.GITHUB_SHA!
	: "main";
const themeBase = giscusConfig.themeBaseUrl.replace("{revision}", revision);
const discussionUrl = target.mapping === "number"
	? `https://github.com/${giscusConfig.repo}/discussions/${target.term}`
	: `https://github.com/${giscusConfig.repo}/discussions`;
---
<section id="comments" aria-labelledby="comments-title" data-pagefind-ignore class="comments-card card-base relative isolate mb-4 px-6 py-6 md:px-9 font-mono overflow-hidden">
    <!-- Retro CRT Scanline & Subtle Vignette Overlay -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.03] dark:opacity-[0.05] bg-[radial-gradient(ellipse_at_center,transparent_30%,black_100%)]"></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.02] dark:opacity-[0.04] bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.8)_3px,rgba(0,0,0,0.8)_4px)]"></div>

    <!-- Four Corner Screws/Crosshairs -->
    <span class="absolute top-2.5 left-2.5 text-[8px] text-black/15 dark:text-white/15 select-none pointer-events-none">+</span>
    <span class="absolute top-2.5 right-2.5 text-[8px] text-black/15 dark:text-white/15 select-none pointer-events-none">+</span>
    <span class="absolute bottom-2.5 left-2.5 text-[8px] text-black/15 dark:text-white/15 select-none pointer-events-none">+</span>
    <span class="absolute bottom-2.5 right-2.5 text-[8px] text-black/15 dark:text-white/15 select-none pointer-events-none">+</span>

    {giscusConfig.bannerBackground && siteConfig.banner.enable && (
        <div class="comments-backdrop absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
            <ImageWrapper src={siteConfig.banner.src} basePath="/" position={siteConfig.banner.position} class="h-full w-full" />
        </div>
    )}

    <!-- Cyberpunk Terminal Header Ribbon -->
    <header class="mb-5 pb-3 border-b border-black/10 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
        <div class="space-y-1">
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--primary)] tracking-wider">
                <span class="inline-block w-2 h-2 rounded-full bg-[var(--primary)] shadow-[0_0_8px_var(--primary)] animate-pulse"></span>
                <span>COMMS-CHANNEL // 实时通信信道</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-black/40 dark:text-white/40">CH-DISCUSS</span>
            </div>
            <h2 id="comments-title" class="text-lg md:text-xl font-extrabold text-black/90 dark:text-white/90 tracking-tight">
                评论与信号交换 // TRANSMISSION LOGS
            </h2>
        </div>
        <div class="flex items-center gap-2">
            <a class="px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-black/5 dark:bg-white/5 hover:bg-[var(--primary)]/15 border border-black/10 dark:border-white/10 hover:border-[var(--primary)]/40 text-black/70 dark:text-white/70 hover:text-[var(--primary)] transition flex items-center gap-1.5" href={discussionUrl} target="_blank" rel="noopener noreferrer">
                <span>在 GitHub 讨论区查看</span>
                <span class="text-[10px]">↗</span>
            </a>
        </div>
    </header>

    <blog-comments
        data-repo={giscusConfig.repo}
        data-repo-id={giscusConfig.repoId}
        data-category={giscusConfig.category}
        data-category-id={giscusConfig.categoryId}
        data-lang={giscusConfig.lang}
        data-mapping={target.mapping}
        data-term={target.term}
        data-theme-base={themeBase}
    >
        <div data-comment-status role="status" class="flex items-center gap-2.5 text-xs font-mono text-black/50 dark:text-white/50 py-6">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            <span>CONNECTING TO SATELLITE // 正在连接讨论区...</span>
        </div>
        <button data-comment-retry type="button" class="btn-regular font-mono text-xs rounded-lg px-4 py-2" hidden>
            重新握手连接 // RETRY HANDSHAKE
        </button>
        <div data-comment-widget></div>
    </blog-comments>
    <noscript><p class="text-sm font-mono text-black/60 dark:text-white/60">启用 JavaScript 后可查看评论，也可以通过上方链接访问 GitHub 讨论。</p></noscript>
</section>

<style>
    .comments-card,
    :global(blog-comments giscus-widget)::part(iframe) {
        color-scheme: light;
    }
    :global(.dark) .comments-card,
    :global(.dark blog-comments giscus-widget)::part(iframe) {
        color-scheme: dark;
    }
    .comments-backdrop {
        opacity: 0.13;
        mask-image: linear-gradient(to bottom, black, rgb(0 0 0 / 65%));
    }
    :global(.dark) .comments-backdrop {
        display: none;
    }
    blog-comments {
        display: block;
        min-height: 160px;
    }
    blog-comments [hidden] {
        display: none;
    }
</style>

<script>
    import "../scripts/giscus";
</script>
